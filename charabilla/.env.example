# Copier ce fichier en .env.local et remplir les valeurs (jamais commité).

# Mot de passe du back-office /admin (8 caractères minimum). Sans lui, /admin reste fermé.
ADMIN_PASSWORD=

# Clé OpenAI pour la génération d'illustrations (gpt-image-1).
# Sans clé : mode démonstration, « générer » renvoie le croquis provisoire du mot.
OPENAI_API_KEY=

# Réglages facultatifs
# GENERATION_QUALITE=medium          # low | medium | high (coût croissant)
# GENERATION_LIMITE_HEURE=12         # générations par visiteur et par heure
# BIBLIOTHEQUE_DIR=./bibliotheque    # dossier des images et des signalements
