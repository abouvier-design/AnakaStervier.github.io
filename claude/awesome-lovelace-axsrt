  document.getElementById('ms-etat').textContent   = result.etat;
  document.getElementById('ms-vn').textContent     = result.valeur_neuve ? result.valeur_neuve + ' €' : '—';
  document.getElementById('ms-vo').textContent     = result.valeur_occasion ? result.valeur_occasion + ' €' : '—';
  document.getElementById('ms-reco').textContent   = result.recommandation;
  document.getElementById('modal-scan').classList.remove('hidden');
}

// Valider le scan et ajouter à l'inventaire
function validerEtRanger() {
  if (!state.scanResult) return;

  const newItem = {
    id: Date.now(),
    ...state.scanResult,
    meuble: 'À définir',
    contenant: null,
    quantite: 1,
    frequence: 'mensuel',
    peremption: null,
    facture: false,
    note: 'Ajouté par scan IA',
    potentiel_revente: 'moyen',
    volume_m3: 0.005
  };

  inventaire.unshift(newItem);
  document.getElementById('modal-scan').classList.add('hidden');
  updateStats();
  ajouterScanRecent(newItem);
  toast('✓ ' + newItem.nom + ' ajouté à l\'inventaire');
  showScreen('inventaire');
  state.scanResult = null;
}

// Ajouter à la liste des scans récents (écran scan)
function ajouterScanRecent(item) {
  const container = document.getElementById('recent-scans');
  if (!container) return;

  // Vider le placeholder si présent
  const placeholder = container.querySelector('p');
  if (placeholder) placeholder.remove();

  const div = document.createElement('div');
  div.className = 'bg-[#111418] border border-white/[.05] rounded-xl p-3 flex items-center gap-3 card-enter';
  div.innerHTML = `
    <span class="text-2xl flex-shrink-0">${item.emoji}</span>
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-sm truncate">${item.nom}</p>
      <p class="text-[10px] text-gray-500">${item.piece} · ${item.etat}</p>
    </div>
    <span class="badge badge-${item.statut}">${item.statut}</span>
  `;
  container.insertBefore(div, container.firstChild);
}

// Scan massif — point d'intégration future
function scanMassif() {
