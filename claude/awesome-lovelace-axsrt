<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <!--
    viewport : maximum-scale=1 évite le zoom auto sur iOS lors du focus sur input
    width=device-width garantit le rendu pleine largeur sur tous les mobiles
  -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="theme-color" content="#05070A" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>LOCUS — Google Maps du Logement</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* ─── Reset & base ─────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }

    /* ─── Masquage barre de défilement horizontale des tabs ─ */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    /* ─── Safe area pour iPhone avec notch / home bar ──────── */
    .pb-safe { padding-bottom: max(env(safe-area-inset-bottom, 0px), 8px); }
    .pt-safe { padding-top: env(safe-area-inset-top, 0px); }

    /* ─── Animations cartes ─────────────────────────────────── */
    @keyframes cardSlide {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .card-enter { animation: cardSlide .25s ease-out both; }

    /* ─── Scan : ligne animée ───────────────────────────────── */
    @keyframes scanLine {
      0%, 100% { top: 20%; }
      50%       { top: 80%; }
    }
    .scan-line {
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #3b82f6, transparent);
      animation: scanLine 1.8s ease-in-out infinite;
    }

    /* ─── Notification toast ────────────────────────────────── */
    #toast {
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
      transition: opacity .3s, transform .3s;
      z-index: 9999;
      pointer-events: none;
      white-space: nowrap;
    }
    #toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ─── Bottom sheet modal ────────────────────────────────── */
    .bottom-sheet {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(0,0,0,.6);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 0 0 env(safe-area-inset-bottom, 0px);
    }
    .bottom-sheet-inner {
      background: #0d1117;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 28px 28px 0 0;
      width: 100%;
      max-width: 480px;
      padding: 24px;
      max-height: 92vh;
      overflow-y: auto;
    }

    /* ─── Nav active state ──────────────────────────────────── */
    .nav-btn.active .nav-ico { filter: none; opacity: 1; }
    .nav-btn .nav-ico { opacity: .45; }
    .nav-btn.active .nav-lbl { color: #3b82f6 !important; }
    .nav-lbl { font-size: 9px; color: #6b7280; font-weight: 600; margin-top: 2px; }

    /* ─── Badge statut ──────────────────────────────────────── */
    .badge { display: inline-block; font-size: 9px; font-weight: 700;
             padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
    .badge-garder   { background:#14532d22; color:#4ade80; border:1px solid #4ade8030; }
    .badge-vendre   { background:#7c2d1222; color:#fb923c; border:1px solid #fb923c30; }
    .badge-donner   { background:#1e3a5f22; color:#60a5fa; border:1px solid #60a5fa30; }
    .badge-recycler { background:#0f3d3922; color:#34d399; border:1px solid #34d39930; }
    .badge-jeter    { background:#3d0f0f22; color:#f87171; border:1px solid #f8717130; }
    .badge-réparer  { background:#3d350022; color:#fbbf24; border:1px solid #fbbf2430; }
    .badge-prêté    { background:#2d1b5522; color:#c084fc; border:1px solid #c084fc30; }

    /* ─── Tabs filter ───────────────────────────────────────── */
    .tab-pill {
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 10px;
      font-weight: 700;
      white-space: nowrap;
      border: 1px solid rgba(255,255,255,.06);
      cursor: pointer;
      transition: background .15s, color .15s;
      background: #111418;
      color: #9ca3af;
    }
    .tab-pill.active {
      background: #2563eb;
      color: #fff;
      border-color: transparent;
    }

    /* ─── Input focus ───────────────────────────────────────── */
    input:focus { outline: none; border-color: rgba(59,130,246,.5) !important; }

    /* ─── Scroll snap pour onboarding ──────────────────────── */
    .snap-x { scroll-snap-type: x mandatory; }
    .snap-start { scroll-snap-align: start; }
  </style>
</head>

<body class="bg-[#05070A] text-white font-sans overflow-x-hidden">

<!-- ════════════════════════════════════════════════════════════
     TOAST (notification légère)
═════════════════════════════════════════════════════════════ -->
<div id="toast" class="bg-[#1a1f2e] border border-white/10 text-white text-xs font-semibold px-4 py-2.5 rounded-full shadow-xl">
  Message
</div>

<!-- ════════════════════════════════════════════════════════════
     CONTENU PRINCIPAL — pleine largeur sur mobile
═════════════════════════════════════════════════════════════ -->
<main class="w-full min-h-screen pb-24 max-w-[480px] mx-auto">

  <!-- ══════════════ ÉCRAN : INVENTAIRE (défaut) ══════════════ -->
  <section id="screen-inventaire" class="screen">

    <!-- Header sticky -->
    <div class="sticky top-0 bg-[#05070A]/95 backdrop-blur-md z-40 px-4 pt-4 pb-3 border-b border-white/[.04]">
      <div class="flex justify-between items-center mb-3">
        <div>
          <h1 class="text-xl font-black tracking-tight text-blue-500 leading-none">LOCUS</h1>
          <p class="text-[10px] text-gray-600 mt-0.5">Le Google Maps de vos objets</p>
        </div>
        <button onclick="showScreen('settings')" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sm active:bg-white/10 transition">⚙️</button>
      </div>

      <!-- Filtres pièces -->
      <div class="flex gap-2 overflow-x-auto no-scrollbar">
        <button class="tab-pill active" data-piece="all" onclick="filtrerPiece('all')">Tout</button>
        <button class="tab-pill" data-piece="Salon" onclick="filtrerPiece('Salon')">🛋️ Salon</button>
        <button class="tab-pill" data-piece="Cuisine" onclick="filtrerPiece('Cuisine')">🍳 Cuisine</button>
        <button class="tab-pill" data-piece="Chambre" onclick="filtrerPiece('Chambre')">🛏️ Chambre</button>
        <button class="tab-pill" data-piece="Salle de bain" onclick="filtrerPiece('Salle de bain')">🚿 SDB</button>
        <button class="tab-pill" data-piece="Bureau" onclick="filtrerPiece('Bureau')">💻 Bureau</button>
        <button class="tab-pill" data-piece="Cave" onclick="filtrerPiece('Cave')">📦 Cave</button>
      </div>
    </div>

    <div class="px-4 pt-4 space-y-4">

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-2xl p-4">
          <p class="text-[9px] uppercase tracking-widest opacity-70 font-bold">Valeur totale</p>
          <p id="stat-valeur" class="text-2xl font-black mt-1 tabular-nums">0 €</p>
        </div>
        <div class="bg-[#111418] border border-white/[.05] rounded-2xl p-4">
          <p class="text-[9px] uppercase tracking-widest text-gray-500 font-bold">Objets inventoriés</p>
          <p id="stat-objets" class="text-2xl font-black mt-1 tabular-nums">0</p>
        </div>
      </div>

      <!-- Alerte tri -->
      <div id="alert-tri" class="bg-orange-500/[.08] border border-orange-500/20 rounded-2xl p-3 flex gap-3 items-start">
        <span class="text-lg mt-0.5">🔄</span>
        <div>
          <p id="alert-tri-text" class="text-xs font-semibold text-orange-300"></p>
          <p class="text-[10px] text-gray-500 mt-0.5">Désencombrez pour libérer de la valeur et de l'espace.</p>
        </div>
      </div>

      <!-- Barre de recherche -->
      <div class="relative">
        <input
          id="search-inv"
          type="search"
          placeholder="Rechercher dans l'inventaire…"
          oninput="renderInventaire()"
          class="w-full bg-[#111418] border border-white/[.06] rounded-2xl px-4 py-3 pr-10 text-sm text-white placeholder-gray-600"
        />
        <span class="absolute right-4 top-3.5 text-gray-600 pointer-events-none">🔍</span>
      </div>

      <!-- Liste objets -->
      <div id="liste-objets" class="space-y-3 pb-2"></div>

    </div>
  </section>

  <!-- ══════════════ ÉCRAN : RECHERCHE AVANT ACHAT ═══════════ -->
  <section id="screen-recherche" class="screen hidden">
    <div class="px-4 pt-6 space-y-4">

      <div>
        <h2 class="text-xl font-black">Recherche avant achat</h2>
        <p class="text-[11px] text-gray-500 mt-1">Évitez les achats inutiles — vérifiez d'abord.</p>
      </div>

      <div class="relative">
        <input
          id="search-achat"
          type="search"
          placeholder="câble, médicament, jouet…"
          oninput="rechercheAvantAchat(this.value)"
          class="w-full bg-[#111418] border border-white/[.06] rounded-2xl px-4 py-4 pr-10 text-base text-white placeholder-gray-600"
          autocomplete="off"
        />
        <span class="absolute right-4 top-4 text-gray-600 pointer-events-none">🔍</span>
      </div>

      <div id="achat-results">
        <div class="text-center py-16 text-gray-600">
          <div class="text-5xl mb-3">🏠</div>
          <p class="text-sm font-medium">Tapez ce que vous voulez acheter</p>
          <p class="text-xs mt-1 text-gray-700">L'app vérifie si vous l'avez déjà chez vous</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════ ÉCRAN : SCAN ═════════════════════════════ -->
  <section id="screen-scan" class="screen hidden">
    <div class="px-4 pt-6 space-y-4">

      <div class="flex items-center gap-2">
        <h2 class="text-xl font-black">Scanner</h2>
        <span class="text-[9px] bg-blue-500/15 text-blue-400 border border-blue-500/20 px-2 py-0.5 rounded-full font-bold">IA Visuelle</span>
      </div>

      <!--
        FIX SCAN MOBILE :
        On utilise <label for="camera-input"> à la place d'un div + JS .click().
        Le label déclenche nativement l'input sur mobile (y compris Safari iOS).
        L'attribut `capture` est ajouté dynamiquement en JS selon le device.
      -->
      <label
        for="camera-input"
        class="block bg-[#111418] border-2 border-dashed border-blue-500/25 rounded-[24px] p-8 text-center cursor-pointer active:scale-[.98] active:bg-blue-500/[.04] transition-all select-none"
      >
        <div class="relative w-16 h-16 mx-auto mb-4">
          <div class="w-16 h-16 bg-blue-500/15 rounded-2xl flex items-center justify-center text-3xl">📷</div>
        </div>
        <h3 class="font-bold text-base">Scanner un objet</h3>
        <p class="text-xs text-gray-500 mt-1">Photo → analyse IA → rangement suggéré</p>
        <div class="mt-5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold py-2.5 px-7 rounded-full inline-block transition">
          Ouvrir la caméra
        </div>
      </label>

      <!--
        INPUT FILE CACHÉ :
        - Sur mobile : `capture="environment"` est injecté par JS → ouvre la caméra arrière
        - Sur desktop : pas d'attribut capture → ouvre le sélecteur de fichiers
        - L'attribut `accept="image/*"` est toujours présent
      -->
      <input
        type="file"
        id="camera-input"
        accept="image/*"
        class="hidden"
        aria-hidden="true"
        onchange="handleImageInput(event)"
      />

      <!-- Option galerie (retire le capture pour afficher galerie sur mobile aussi) -->
      <button
        onclick="openGallery()"
        class="w-full bg-[#111418] border border-white/[.05] rounded-2xl p-4 flex items-center gap-4 active:scale-[.98] transition text-left"
      >
        <div class="bg-purple-500/15 p-3 rounded-xl text-purple-400 text-xl flex-shrink-0">🖼️</div>
        <div>
          <p class="font-semibold text-sm">Depuis la galerie</p>
          <p class="text-xs text-gray-500">Choisir une photo existante</p>
        </div>
      </button>

      <!-- Scan massif -->
      <button
        onclick="scanMassif()"
        class="w-full bg-[#111418] border border-white/[.05] rounded-2xl p-4 flex items-center gap-4 active:scale-[.98] transition text-left"
      >
        <div class="bg-green-500/15 p-3 rounded-xl text-green-400 text-xl flex-shrink-0">📦</div>
        <div>
          <p class="font-semibold text-sm">Scan massif placard / boîte</p>
          <p class="text-xs text-gray-500">Identifiez tout le contenu d'un espace</p>
        </div>
      </button>

      <!-- Notice API -->
      <div id="api-notice" class="bg-yellow-500/[.08] border border-yellow-500/20 rounded-2xl p-3">
        <p class="text-xs text-yellow-300 font-semibold">Mode démo activé</p>
        <p class="text-[10px] text-gray-400 mt-0.5">
          Configurez votre clé API Gemini dans les Réglages pour activer l'analyse IA réelle.
          En mode démo, un résultat simulé est affiché.
        </p>
      </div>

      <!-- Scans récents -->
      <div>
        <p class="text-[10px] font-bold uppercase tracking-wider text-gray-600 mb-3">Scans récents</p>
        <div id="recent-scans" class="space-y-2">
          <p class="text-xs text-gray-700 text-center py-4">Aucun scan pour l'instant</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════ ÉCRAN : TRI & ÉCONOMIE CIRCULAIRE ════════ -->
  <section id="screen-tri" class="screen hidden">
    <div class="px-4 pt-6 space-y-4">

      <div>
        <h2 class="text-xl font-black">Tri & Économie circulaire</h2>
        <p class="text-[11px] text-gray-500 mt-1">Désencombrez intelligemment.</p>
      </div>

      <!-- Stats tri -->
      <div id="tri-stats" class="grid grid-cols-3 gap-2"></div>

      <!-- Onglets tri -->
      <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
        <button class="tab-pill active" data-tri="all" onclick="filtrerTri('all')">Tout</button>
        <button class="tab-pill" data-tri="vendre" onclick="filtrerTri('vendre')">💰 Vendre</button>
        <button class="tab-pill" data-tri="donner" onclick="filtrerTri('donner')">❤️ Donner</button>
        <button class="tab-pill" data-tri="réparer" onclick="filtrerTri('réparer')">🔧 Réparer</button>
        <button class="tab-pill" data-tri="recycler" onclick="filtrerTri('recycler')">♻️ Recycler</button>
        <button class="tab-pill" data-tri="jeter" onclick="filtrerTri('jeter')">🗑️ Jeter</button>
      </div>

      <div id="tri-list" class="space-y-3 pb-4"></div>

    </div>
  </section>

  <!-- ══════════════ ÉCRAN : RÉGLAGES ═════════════════════════ -->
  <section id="screen-settings" class="screen hidden">
    <div class="px-4 pt-6 space-y-5 pb-8">

      <div>
        <h2 class="text-xl font-black">Réglages</h2>
        <p class="text-[11px] text-gray-500 mt-1">Configuration et confidentialité</p>
      </div>

      <!-- Clé API -->
      <div class="bg-[#111418] border border-white/[.05] rounded-2xl p-4 space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-base">🔑</span>
          <h3 class="font-semibold text-sm">Clé API Gemini</h3>
          <span class="text-[9px] bg-blue-500/15 text-blue-400 px-2 py-0.5 rounded-full">Optionnel</span>
        </div>
        <p class="text-[10px] text-gray-500">
          Obtenez votre clé gratuite sur <strong class="text-gray-300">aistudio.google.com</strong> pour activer
          l'analyse visuelle IA de vos objets.
        </p>
        <input
          id="api-key-input"
          type="password"
          placeholder="AIza…"
          class="w-full bg-black/30 border border-white/10 rounded-xl px-3 py-2.5 text-sm text-white placeholder-gray-700 font-mono"
        />
        <button
          onclick="saveApiKey()"
          class="bg-blue-600 text-white text-sm font-bold py-2.5 px-5 rounded-xl active:scale-95 transition"
        >
          Enregistrer
        </button>
      </div>

      <!-- Confidentialité -->
      <div class="bg-[#111418] border border-white/[.05] rounded-2xl p-4 space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-base">🔒</span>
          <h3 class="font-semibold text-sm">Confidentialité</h3>
        </div>

        <div class="space-y-4 text-sm divide-y divide-white/[.04]">
          <div class="flex justify-between items-center">
            <div>
              <p class="font-medium text-sm">Stockage local uniquement</p>
              <p class="text-[10px] text-gray-500 mt-0.5">Vos données restent sur l'appareil</p>
            </div>
            <div id="toggle-local" class="w-11 h-6 bg-blue-600 rounded-full relative cursor-pointer flex-shrink-0" onclick="toggleSwitch('toggle-local')">
              <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full shadow transition-all"></div>
            </div>
          </div>
          <div class="pt-4 flex justify-between items-center">
            <div>
              <p class="font-medium text-sm">Export uniquement sur sélection</p>
              <p class="text-[10px] text-gray-500 mt-0.5">Contrôle total de vos données partagées</p>
            </div>
            <div id="toggle-export" class="w-11 h-6 bg-blue-600 rounded-full relative cursor-pointer flex-shrink-0" onclick="toggleSwitch('toggle-export')">
              <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full shadow transition-all"></div>
            </div>
          </div>
          <div class="pt-4 flex justify-between items-center">
            <div>
              <p class="font-medium text-sm">Masquer certaines pièces</p>
              <p class="text-[10px] text-gray-500 mt-0.5">Fonctionnalité à venir</p>
            </div>
            <div class="w-11 h-6 bg-white/10 rounded-full relative flex-shrink-0 opacity-40">
              <div class="absolute left-1 top-1 w-4 h-4 bg-white rounded-full shadow"></div>
            </div>
          </div>
          <div class="pt-4">
            <button onclick="confirmerSuppression()" class="text-red-400 text-xs font-semibold flex items-center gap-1.5">
              <span>🗑️</span> Supprimer toutes mes données
            </button>
          </div>
        </div>
      </div>

      <!-- À propos -->
      <div class="bg-[#111418] border border-white/[.05] rounded-2xl p-5 text-center">
        <p class="text-blue-500 font-black text-xl tracking-tight">LOCUS</p>
        <p class="text-xs text-gray-500 mt-1">Le Google Maps de vos objets</p>
        <p class="text-[10px] text-gray-700 mt-3">v6.0 · Prototype · 19 €/an</p>
        <p class="text-[9px] text-gray-700 mt-1">Partenaires futurs : déménageurs · assureurs · économie circulaire</p>
      </div>

    </div>
  </section>

</main>

<!-- ════════════════════════════════════════════════════════════
     NAVIGATION BAS — fixe, pleine largeur, safe area iOS
═════════════════════════════════════════════════════════════ -->
<nav class="fixed bottom-0 left-0 right-0 bg-[#0a0c10]/95 backdrop-blur-md border-t border-white/[.05] z-50">
  <div class="flex justify-around items-end max-w-[480px] mx-auto px-2 pt-2 pb-safe">

    <button onclick="showScreen('inventaire')" class="nav-btn active flex flex-col items-center pb-1 min-w-[52px]" data-screen="inventaire">
      <span class="nav-ico text-[22px]">🏠</span>
      <span class="nav-lbl">Maison</span>
    </button>

    <button onclick="showScreen('recherche')" class="nav-btn flex flex-col items-center pb-1 min-w-[52px]" data-screen="recherche">
      <span class="nav-ico text-[22px]">🔍</span>
      <span class="nav-lbl">Chercher</span>
    </button>

    <!-- Bouton scan central mis en avant -->
    <button onclick="showScreen('scan')" class="nav-btn flex flex-col items-center -mt-5 min-w-[64px]" data-screen="scan">
      <span class="bg-blue-600 rounded-2xl p-3.5 block shadow-lg shadow-blue-600/40 nav-ico text-[24px]">📷</span>
      <span class="nav-lbl mt-1">Scanner</span>
    </button>

    <button onclick="showScreen('tri')" class="nav-btn flex flex-col items-center pb-1 min-w-[52px]" data-screen="tri">
      <span class="nav-ico text-[22px]">♻️</span>
      <span class="nav-lbl">Trier</span>
    </button>

    <button onclick="showScreen('settings')" class="nav-btn flex flex-col items-center pb-1 min-w-[52px]" data-screen="settings">
      <span class="nav-ico text-[22px]">⚙️</span>
      <span class="nav-lbl">Réglages</span>
    </button>

  </div>
</nav>

<!-- ════════════════════════════════════════════════════════════
     MODAL : Résultat du scan IA
═════════════════════════════════════════════════════════════ -->
<div id="modal-scan" class="bottom-sheet hidden" onclick="closeModalOnBackdrop(event,'modal-scan')">
  <div class="bottom-sheet-inner">

    <div class="flex justify-between items-start mb-4">
      <div class="flex items-center gap-3">
        <span id="ms-emoji" class="text-4xl">📦</span>
        <div>
          <h3 id="ms-nom" class="text-lg font-black leading-tight">Objet identifié</h3>
          <p id="ms-cat" class="text-xs text-gray-500">Catégorie</p>
        </div>
      </div>
      <button onclick="document.getElementById('modal-scan').classList.add('hidden')" class="text-gray-500 text-xl p-1">✕</button>
    </div>

    <div class="grid grid-cols-2 gap-2 mb-4">
      <div class="bg-white/[.04] rounded-xl p-3">
        <p class="text-[9px] text-gray-500 uppercase tracking-wider">Pièce conseillée</p>
        <p id="ms-piece" class="font-semibold text-sm mt-1">—</p>
      </div>
      <div class="bg-white/[.04] rounded-xl p-3">
        <p class="text-[9px] text-gray-500 uppercase tracking-wider">État estimé</p>
