// ──────────────────────────────────────────────────────────────
// RENDU INVENTAIRE
// ──────────────────────────────────────────────────────────────
function renderInventaire() {
  const container = document.getElementById('liste-objets');
  if (!container) return;

  const query = (document.getElementById('search-inv')?.value || '').toLowerCase();
  let items = inventaire;

  // Filtre pièce
  if (state.pieceFilter !== 'all') {
    items = items.filter(i => i.piece === state.pieceFilter);
  }

  // Filtre recherche
  if (query.length >= 2) {
    items = items.filter(i =>
      i.nom.toLowerCase().includes(query) ||
      i.categorie.toLowerCase().includes(query) ||
      i.piece.toLowerCase().includes(query) ||
      (i.note && i.note.toLowerCase().includes(query))
    );
  }

  if (!items.length) {
    container.innerHTML = `
      <div class="text-center py-12 text-gray-600">
        <div class="text-4xl mb-3">🔍</div>
        <p class="text-sm">Aucun objet trouvé</p>
      </div>`;
    return;
  }

  container.innerHTML = items.map((item, i) => {
    const expired = item.peremption && new Date(item.peremption) < new Date();
    const delay = Math.min(i * 30, 300);
    return `
      <div class="bg-[#111418] border ${expired ? 'border-red-500/25' : 'border-white/[.04]'} rounded-2xl p-4 card-enter" style="animation-delay:${delay}ms">
        <div class="flex items-start gap-3">
          <span class="text-3xl flex-shrink-0 mt-0.5">${item.emoji}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="font-semibold text-sm leading-tight truncate">${item.nom}</h3>
                <p class="text-[10px] text-gray-500 mt-0.5 truncate">${item.piece}${item.meuble ? ' · ' + item.meuble : ''}</p>
              </div>
              <span class="badge badge-${item.statut} flex-shrink-0">${item.statut}</span>
            </div>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2">
              <span class="text-[10px] text-gray-400">Qté : <strong>${item.quantite}</strong></span>
              <span class="text-[10px] text-gray-500">${item.etat}</span>
              ${item.valeur_occasion > 0 ? `<span class="text-[10px] text-green-400 font-semibold">~${item.valeur_occasion} € occ.</span>` : ''}
              ${expired ? `<span class="text-[9px] bg-red-500/15 text-red-400 border border-red-500/20 px-1.5 py-0.5 rounded-full font-bold">⚠️ PÉRIMÉ</span>` : ''}
              ${item.facture ? `<span class="text-[9px] text-gray-600">🧾 facture</span>` : ''}
            </div>

            ${item.recommandation ? `
              <p class="text-[10px] text-blue-300/60 mt-2 leading-relaxed">💡 ${item.recommandation}</p>
            ` : ''}

            ${['vendre', 'donner'].includes(item.statut) ? `
              <button
                onclick="genererAnnonce(${item.id})"
                class="mt-2.5 text-[10px] bg-blue-500/[.08] text-blue-400 border border-blue-500/15 px-3 py-1.5 rounded-full font-semibold active:scale-95 transition"
              >
                Générer une annonce →
              </button>
            ` : ''}
          </div>
        </div>
      </div>
    `;
  }).join('');
}

// Filtre par pièce
function filtrerPiece(piece) {
  state.pieceFilter = piece;
  document.querySelectorAll('[data-piece]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.piece === piece);
  });
  renderInventaire();
}

// ──────────────────────────────────────────────────────────────
// RECHERCHE AVANT ACHAT
// ──────────────────────────────────────────────────────────────
function rechercheAvantAchat(query) {
  const container = document.getElementById('achat-results');
  if (!query || query.length < 2) {
    container.innerHTML = `
      <div class="text-center py-16 text-gray-600">
        <div class="text-5xl mb-3">🏠</div>
        <p class="text-sm font-medium">Tapez ce que vous voulez acheter</p>
        <p class="text-xs mt-1 text-gray-700">L'app vérifie si vous l'avez déjà chez vous</p>
      </div>`;
    return;
  }

  const q = query.toLowerCase();
  const found = inventaire.filter(i =>
    i.nom.toLowerCase().includes(q) ||
    i.categorie.toLowerCase().includes(q) ||
    (i.note && i.note.toLowerCase().includes(q))
  );

  if (!found.length) {
    container.innerHTML = `
      <div class="bg-green-500/[.08] border border-green-500/20 rounded-2xl p-5 text-center">
        <div class="text-3xl mb-2">✅</div>
        <p class="font-semibold text-green-400">Pas trouvé dans votre logement</p>
        <p class="text-xs text-gray-500 mt-1">Vous pouvez acheter « ${query} » en toute sérénité.</p>
      </div>`;
    return;
  }

  // Alerte douce — pas alarmiste
  const alertBlock = `
    <div class="bg-blue-500/[.07] border border-blue-500/15 rounded-2xl p-3 flex items-start gap-3">
      <span class="text-xl mt-0.5 flex-shrink-0">💡</span>
      <div>
        <p class="text-sm font-semibold text-blue-300">Objet similaire déjà présent</p>
        <p class="text-xs text-gray-400 mt-0.5">Vérifiez ce que vous possédez avant d'acheter — vous l'avez peut-être déjà.</p>
      </div>
    </div>
  `;

  const itemsHtml = found.map(item => `
    <div class="bg-[#111418] border border-white/[.04] rounded-2xl p-4 card-enter">
      <div class="flex items-start gap-3">
        <span class="text-2xl flex-shrink-0">${item.emoji}</span>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start gap-2">
            <div class="min-w-0">
              <h4 class="font-semibold text-sm truncate">${item.nom}</h4>
              <p class="text-[10px] text-gray-500 mt-0.5">${item.piece} · ${item.meuble || ''}</p>
            </div>
            <span class="badge badge-${item.statut} flex-shrink-0">${item.statut}</span>
          </div>
          <div class="flex gap-3 mt-1.5">
            <span class="text-[10px]">Qté : <strong>${item.quantite}</strong></span>
            <span class="text-[10px] text-gray-400">État : ${item.etat}</span>
            ${item.valeur_neuve ? `<span class="text-[10px] text-gray-500">~${item.valeur_neuve} € neuf</span>` : ''}
          </div>
        </div>
      </div>
    </div>
  `).join('');

  container.innerHTML = alertBlock + itemsHtml;
}

// ──────────────────────────────────────────────────────────────
// TRI & ÉCONOMIE CIRCULAIRE
// ──────────────────────────────────────────────────────────────
function renderTri() {
  const aTrierStatuts = ['vendre', 'donner', 'réparer', 'recycler', 'jeter'];
  const counts = {};
  let potentiel = 0;

  aTrierStatuts.forEach(s => { counts[s] = 0; });
  inventaire.forEach(item => {
    if (counts[item.statut] !== undefined) counts[item.statut]++;
    if (['vendre', 'donner'].includes(item.statut)) potentiel += (item.valeur_occasion || 0);
  });

  const statsContainer = document.getElementById('tri-stats');
  if (statsContainer) {
    statsContainer.innerHTML = `
      <div class="bg-orange-500/[.08] border border-orange-500/15 rounded-xl p-3 text-center">
        <p class="text-xl font-black text-orange-400">${counts.vendre}</p>
        <p class="text-[9px] text-gray-500 mt-0.5">À vendre</p>
      </div>
      <div class="bg-blue-500/[.08] border border-blue-500/15 rounded-xl p-3 text-center">
        <p class="text-xl font-black text-blue-400">${counts.donner}</p>
        <p class="text-[9px] text-gray-500 mt-0.5">À donner</p>
      </div>
      <div class="bg-green-500/[.08] border border-green-500/15 rounded-xl p-3 text-center">
        <p class="text-xl font-black text-green-400">${Math.round(potentiel)}<span class="text-xs">€</span></p>
        <p class="text-[9px] text-gray-500 mt-0.5">Potentiel</p>
      </div>
    `;
  }

  filtrerTri(state.triFilter);
}

function filtrerTri(statut) {
  state.triFilter = statut;
  const aTrierStatuts = ['vendre', 'donner', 'réparer', 'recycler', 'jeter'];

  document.querySelectorAll('[data-tri]').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tri === statut);
  });

  const items = statut === 'all'
    ? inventaire.filter(i => aTrierStatuts.includes(i.statut))
    : inventaire.filter(i => i.statut === statut);

  const container = document.getElementById('tri-list');
  if (!container) return;

  if (!items.length) {
    container.innerHTML = `<div class="text-center py-10 text-gray-600"><p class="text-sm">Aucun objet ici 🎉</p></div>`;
    return;
  }

  container.innerHTML = items.map(item => `
    <div class="bg-[#111418] border border-white/[.04] rounded-2xl p-4 card-enter">
      <div class="flex items-start gap-3">
        <span class="text-2xl flex-shrink-0">${item.emoji}</span>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start gap-2">
            <h4 class="font-semibold text-sm truncate">${item.nom}</h4>
            <span class="badge badge-${item.statut} flex-shrink-0">${item.statut}</span>
          </div>
          <p class="text-[10px] text-gray-500 mt-0.5">${item.piece}</p>
          ${item.valeur_occasion > 0 ? `<p class="text-[10px] text-green-400 mt-1 font-semibold">💰 ~${item.valeur_occasion} € occasion</p>` : ''}
          ${item.recommandation ? `<p class="text-[10px] text-gray-400 mt-1.5 leading-relaxed">${item.recommandation}</p>` : ''}
          ${['vendre', 'donner'].includes(item.statut) ? `
            <button
              onclick="genererAnnonce(${item.id})"
              class="mt-2.5 text-[10px] bg-blue-500/[.08] text-blue-400 border border-blue-500/15 px-3 py-1.5 rounded-full font-semibold active:scale-95 transition"
            >
              📝 Générer une annonce
            </button>
          ` : ''}
        </div>
      </div>
    </div>
  `).join('');
}

// ──────────────────────────────────────────────────────────────
// GÉNÉRATEUR D'ANNONCE
// Point d'intégration API : remplacer la génération locale par
// un appel LLM (Gemini, GPT-4) pour produire une annonce optimisée
// ──────────────────────────────────────────────────────────────
const PLATEFORMES = {
  vendre: [
    { nom: 'Leboncoin',          emoji: '🟠' },
    { nom: 'Vinted',             emoji: '💚' },
    { nom: 'Facebook Marketplace', emoji: '🔵' }
  ],
  donner: [
    { nom: 'Geev',               emoji: '❤️' },
    { nom: 'Emmaüs',             emoji: '🤝' },
    { nom: 'Recyclerie locale',  emoji: '♻️' }
  ]
};

let currentAnnonce = '';

function genererAnnonce(id) {
  const item = inventaire.find(i => i.id === id);
  if (!item) return;

  const plates = PLATEFORMES[item.statut] || PLATEFORMES.vendre;
  const lotStr = item.quantite > 1 ? ` (lot de ${item.quantite})` : '';
  const etatLong = { neuf: 'Neuf', bon: 'Très bon état', usagé: 'Bon état', 'à réparer': 'À réparer' }[item.etat] || item.etat;

  const titre = `${item.nom}${lotStr} — ${etatLong}`;

  const desc = `${item.nom}${lotStr} en ${etatLong.toLowerCase()}.

${item.note ? item.note + '\n' : ''}Raison : désencombrement, objets inutilisés.
${item.facture ? '✓ Facture d\'achat disponible.' : ''}

Prix neuf : ~${item.valeur_neuve} €
${item.statut === 'vendre' ? `Prix demandé : ${item.valeur_occasion} € (négociable)` : 'Gratuit — à récupérer sur place.'}

Contact via messagerie de la plateforme.`;

  currentAnnonce = titre + '\n\n' + desc;

  document.getElementById('an-titre').textContent = titre;
  document.getElementById('an-desc').textContent  = desc;
  document.getElementById('an-prix').textContent  = item.statut === 'vendre' ? item.valeur_occasion + ' €' : 'Gratuit';
  document.getElementById('an-etat').textContent  = etatLong;
  document.getElementById('an-plates').innerHTML  = plates.map(p =>
    `<span class="bg-white/[.05] border border-white/10 text-xs px-3 py-1.5 rounded-full font-medium">${p.emoji} ${p.nom}</span>`
  ).join('');

  document.getElementById('modal-annonce').classList.remove('hidden');
}

function copierAnnonce() {
  if (!currentAnnonce) return;
  navigator.clipboard?.writeText(currentAnnonce).then(() => toast('📋 Annonce copiée !')).catch(() => toast('Copie non disponible sur ce navigateur'));
}

// ──────────────────────────────────────────────────────────────
// CALCUL DES STATS
// ──────────────────────────────────────────────────────────────
function updateStats() {
  const totalValeur = inventaire.reduce((sum, i) => sum + (i.valeur_neuve * i.quantite), 0);
  const totalObjets = inventaire.reduce((sum, i) => sum + i.quantite, 0);
  const aTrierCount = inventaire.filter(i => ['vendre', 'donner', 'recycler', 'jeter', 'réparer'].includes(i.statut)).length;

  const el = (id) => document.getElementById(id);
  if (el('stat-valeur')) el('stat-valeur').textContent = Math.round(totalValeur).toLocaleString('fr-FR') + ' €';
  if (el('stat-objets')) el('stat-objets').textContent = totalObjets;
  if (el('alert-tri-text')) el('alert-tri-text').textContent = aTrierCount + ' objets à trier, vendre ou donner';
}

// ──────────────────────────────────────────────────────────────
// RÉGLAGES
// ──────────────────────────────────────────────────────────────
function saveApiKey() {
  const val = document.getElementById('api-key-input').value.trim();
  if (val) {
    API_KEY = val;
    localStorage.setItem('locus_api_key', val);
    document.getElementById('api-notice')?.classList.add('hidden');
    toast('🔑 Clé API enregistrée');
  }
}

function toggleSwitch(id) {
  const el = document.getElementById(id);
  const isOn = el.classList.contains('bg-blue-600');
  el.classList.toggle('bg-blue-600', !isOn);
  el.classList.toggle('bg-white/10', isOn);
  const dot = el.querySelector('div');
  dot.style.left = isOn ? '4px' : '';
  dot.style.right = isOn ? '' : '4px';
}

function confirmerSuppression() {
  if (confirm('Supprimer toutes vos données ? Cette action est irréversible.')) {
    inventaire = [];
    localStorage.clear();
    updateStats();
    renderInventaire();
    toast('🗑️ Données supprimées');
    showScreen('inventaire');
  }
}

