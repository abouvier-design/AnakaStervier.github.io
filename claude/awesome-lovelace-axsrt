function showScreen(name) {
  // Cacher tous les écrans
  document.querySelectorAll('.screen').forEach(s => s.classList.add('hidden'));

  // Afficher l'écran cible
  const target = document.getElementById('screen-' + name);
  if (target) target.classList.remove('hidden');

  // Mettre à jour la nav
  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.screen === name);
  });

  state.currentScreen = name;

  // Init spécifique à l'écran
  if (name === 'tri') renderTri();
  if (name === 'inventaire') renderInventaire();
}

// ──────────────────────────────────────────────────────────────
// TOAST NOTIFICATION
// ──────────────────────────────────────────────────────────────
let toastTimer;
function toast(msg, duration = 3000) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

// ──────────────────────────────────────────────────────────────
// FERMETURE MODAL AU CLIC SUR LE BACKDROP
// ──────────────────────────────────────────────────────────────
function closeModalOnBackdrop(event, modalId) {
  if (event.target.id === modalId) {
    document.getElementById(modalId).classList.add('hidden');
  }
}

// ──────────────────────────────────────────────────────────────
// INIT CAMERA INPUT
//
// Correction mobile :
//   - Sur mobile (iOS/Android) : on ajoute `capture="environment"`
//     pour déclencher directement la caméra arrière
//   - Sur desktop : pas de capture → sélecteur de fichier standard
//
// On utilise <label for="camera-input"> dans le HTML plutôt qu'un
// div + JS .click() — plus fiable notamment sur Safari iOS qui
// bloque les .click() programmatiques sur input[file].
// ──────────────────────────────────────────────────────────────
function initCameraInput() {
  const input = document.getElementById('camera-input');
  const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  if (isMobile) {
    // Caméra arrière directe sur mobile
    input.setAttribute('capture', 'environment');
  }
  // Sur desktop : l'attribut capture est absent → file picker natif
}

// Ouvrir la galerie (sans caméra directe, même sur mobile)
function openGallery() {
  const input = document.getElementById('camera-input');
  // Retirer temporairement capture pour afficher galerie + caméra au choix
  input.removeAttribute('capture');
  input.click();
}

// Traitement de l'image sélectionnée (caméra ou galerie)
async function handleImageInput(event) {
  const file = event.target.files[0];
  if (!file) return;

  // Reset pour permettre de re-scanner le même fichier
  event.target.value = '';

  // Restaurer capture sur mobile après openGallery
  const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  if (isMobile) event.target.setAttribute('capture', 'environment');

  toast('📷 Chargement de l\'image…');

  const reader = new FileReader();
  reader.readAsDataURL(file);
  reader.onload = async () => {
    const base64 = reader.result.split(',')[1];
    toast('🔍 Analyse en cours…');
    await analyserObjet(base64);
  };
  reader.onerror = () => toast('❌ Erreur lors du chargement');
}

// ──────────────────────────────────────────────────────────────
// ANALYSE IA — Gemini 1.5 Flash (Vision)
//
// API pluggable : remplacer la section fetch() par tout autre
// provider de reconnaissance visuelle (OpenAI Vision, Azure, etc.)
//
// Mode démo : si pas de clé API, résultat simulé aléatoire.
// ──────────────────────────────────────────────────────────────
async function analyserObjet(base64) {

  // ── MODE DÉMO (pas de clé API) ────────────────────────────
  if (!API_KEY) {
    const demos = [
      { nom: 'Câble USB-C', emoji: '🔌', categorie: 'Électronique',
        piece: 'Bureau', etat: 'bon', valeur_neuve: 25, valeur_occasion: 8,
        statut: 'vendre', recommandation: 'Vous avez déjà 3 câbles similaires. Gardez-en 1 et vendez les autres.' },
      { nom: 'Livre de poche', emoji: '📖', categorie: 'Culture',
        piece: 'Salon', etat: 'bon', valeur_neuve: 12, valeur_occasion: 3,
        statut: 'donner', recommandation: 'À donner à une médiathèque ou sur Geev.' },
      { nom: 'Médicament', emoji: '💊', categorie: 'Santé',
        piece: 'Salle de bain', etat: 'à vérifier', valeur_neuve: 8, valeur_occasion: 0,
        statut: 'garder', recommandation: 'Vérifiez la date de péremption avant de ranger.' },
      { nom: 'Chargeur téléphone', emoji: '🔋', categorie: 'Électronique',
        piece: 'Bureau', etat: 'bon', valeur_neuve: 30, valeur_occasion: 10,
        statut: 'garder', recommandation: 'Ranger dans le tiroir câbles avec les autres accessoires.' },
      { nom: 'Vêtement enfant', emoji: '👕', categorie: 'Vêtements',
        piece: 'Chambre bébé', etat: 'bon', valeur_neuve: 25, valeur_occasion: 8,
        statut: 'donner', recommandation: 'Vendre sur Vinted ou donner sur Geev si la taille est dépassée.' },
      { nom: 'Boîte de jeu', emoji: '🎲', categorie: 'Jouets',
        piece: 'Salon', etat: 'bon', valeur_neuve: 35, valeur_occasion: 12,
        statut: 'garder', recommandation: 'Rangez dans le meuble salon avec les autres jeux.' }
    ];
    state.scanResult = demos[Math.floor(Math.random() * demos.length)];
    afficherModalScan(state.scanResult);
    toast('✨ Analyse simulée (mode démo)');
    return;
  }

  // ── APPEL API GEMINI 1.5 FLASH ───────────────────────────
  // Point d'intégration API : modifier l'URL et le body pour
  // utiliser un autre service (OpenAI, Azure CV, Google Vision…)
  const prompt = `Tu es un assistant expert en inventaire de logement.
Analyse cette image et identifie l'objet principal visible.
Réponds UNIQUEMENT avec un JSON valide, sans markdown ni explication :
{
  "nom": "nom précis et court de l'objet",
  "emoji": "emoji le plus représentatif",
  "categorie": "Électronique|Vêtements|Cuisine|Santé|Maison|Culture|Jouets|Bricolage|Documents|Entretien|Autre",
  "piece": "pièce du logement conseillée pour ranger cet objet",
  "etat": "neuf|bon|usagé|à réparer",
  "valeur_neuve": estimation_prix_neuf_en_euros,
  "valeur_occasion": estimation_prix_occasion_en_euros,
  "statut": "garder|vendre|donner|recycler|jeter",
  "recommandation": "conseil de rangement court, bienveillant et actionnable"
}`;

  try {
    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [
            { text: prompt },
            { inline_data: { mime_type: 'image/jpeg', data: base64 } }
          ]}],
          generationConfig: { temperature: 0.1, maxOutputTokens: 512 }
        })
      }
    );

    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err?.error?.message || `HTTP ${response.status}`);
    }

    const data = await response.json();
    const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text || '';

    // Nettoyage robuste : Gemini peut entourer le JSON de ```json … ```
    const cleaned = rawText.replace(/```json\s*/gi, '').replace(/```\s*/g, '').trim();
    state.scanResult = JSON.parse(cleaned);

    afficherModalScan(state.scanResult);
    toast('✅ Analyse IA terminée !');

  } catch (err) {
    console.error('Gemini API error:', err);
    toast('❌ Erreur : ' + err.message);
  }
}

